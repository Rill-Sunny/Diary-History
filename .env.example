# 复制到当前 shell 的环境变量或部署环境中；Spring Boot 不会自动读取此文件。
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/liubai_diary?useUnicode=true&characterEncoding=utf8&connectionTimeZone=%2B00%3A00&forceConnectionTimeZoneToSession=true
SPRING_DATASOURCE_USERNAME=liubai_app
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

APP_BASE_URL=http://localhost:5173
APP_MEDIA_ROOT=./var/media
APP_ADMIN_EMAIL=admin@example.invalid
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123456
APP_ADMIN_NICKNAME=系统管理员

# 仅配置 SMTP 后才能注册、验证邮箱及申请重置密码。
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-me
SPRING_MAIL_PASSWORD=replace-me
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_FROM=no-reply@example.com

# 可选 Web Push。密钥使用未填充的 Base64URL 编码。部署文档说明生成方法。
# APP_PUSH_PUBLIC_KEY=
# APP_PUSH_PRIVATE_KEY=
# APP_PUSH_SUBJECT=mailto:admin@example.com
# APP_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,android.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com

# HTTPS 部署时设为 true；本地 HTTP 开发保持 false。
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
